<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Fine location is required for an Android location-type foreground service. The app
       NEVER reads actual coordinates or collects a user's GPS history. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:allowBackup="false" android:fullBackupContent="false"
      android:usesCleartextTraffic="false" android:label="HereShift"
      android:icon="@drawable/hereshift_icon_light"
      android:roundIcon="@drawable/hereshift_icon_light"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true"
        android:label="HereShift" android:screenOrientation="unspecified">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name=".MockLocationService" android:exported="false"
        android:foregroundServiceType="location" android:stopWithTask="false" />
  </application>
</manifest>